  FILTER(
    CONTAINS(?obj, """"currentPage":"https://services.apps-tei.mow.vlaanderen.be/ldes-server/geplande-opstellingen-v1/by-page?pageNumber=01858b83-86a8-466e-9f90-7c969b20ec31","nextPage":"https://services.apps-tei.mow.vlaanderen.be/ldes-server/geplande-opstellingen-v1/by-page?pageNumber=171beb63-a850-45e4-afcd-6cecbe3d90ca""")
